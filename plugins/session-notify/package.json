{
  "name": "@local/dsh-session-notify",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "审批、提问、计划确认与一轮结束时发送桌面系统通知",
  "license": "MIT",
  "author": "donghuz1",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "desktop-notification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghuz1/dsh_plugin.git",
    "directory": "plugins/session-notify"
  },
  "engines": {
    "dsh": "^0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/client.js",
    "build.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test 'test/*.test.mjs'"
  }
}
