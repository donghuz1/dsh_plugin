{
  "name": "@local/dsh-qoder-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Qoder 风格的 DeepSeek Harness 桌面端主题皮肤",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test 'test/*.test.mjs'"
  }
}
